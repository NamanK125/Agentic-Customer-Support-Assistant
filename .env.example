# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible endpoint (default: Groq) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key-here
# Extra keys rotated on 429/401 (comma-separated), for free-tier rate limits
LLM_API_KEYS_EXTRA=
LLM_MODEL=qwen/qwen3.8-27b
# Per-role models. Groq's free tier caps tokens/minute per model, so roles are spread out.
LLM_MODEL_ROUTER=openai/gpt-oss-20b
LLM_MODEL_GUARD=openai/gpt-oss-120b
LLM_MODEL_AGENT=
# json_schema, json_object, or none (prompt-only + tolerant parsing)
LLM_STRUCTURED_OUTPUT=json_schema
# Groq: "none" turns Qwen3 thinking off (gpt-oss gets "low", its minimum)
LLM_REASONING_EFFORT=none
LLM_DISABLE_THINKING=false
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# Self-hosted alternative (vLLM, OpenAI-compatible):
#   vllm serve <model> --quantization awq_marlin --enable-auto-tool-choice --tool-call-parser hermes
#   LLM_BASE_URL=http://<host>:8000/v1  LLM_API_KEY=EMPTY  LLM_MODEL=<served model id>
#   LLM_MODEL_ROUTER=  LLM_MODEL_GUARD=  LLM_STRUCTURED_OUTPUT=json_schema
#   LLM_DISABLE_THINKING=true  LLM_REASONING_EFFORT=   # Qwen3-style thinking models

# --- Voice: STT (Groq Whisper; local faster-whisper int8 is the automatic fallback) ---
STT_BASE_URL=https://api.groq.com/openai/v1
# Empty = reuse LLM_API_KEY (same Groq account)
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_LANGUAGE=en
STT_LOCAL_MODEL=small

# --- Voice: TTS (streaming WebSocket service; Edge TTS is the automatic fallback) ---
TTS_WS_URL=ws://<tts-host>:<port>/v1/tts/stream
TTS_SPEAKER=RJ_BP_SDV, moderate pitch
TTS_LANGUAGE=English
# Server-side text normalization and phonemization (both on)
TTS_NORMALIZE=true
TTS_PHONEMIZE=true

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_MIN_SCORE overrides the per-model calibrated threshold (MiniLM 0.35, bge-small 0.65)
# RAG_MIN_SCORE=0.35

# --- Scale-out state (unset = in-process memory) ---
REDIS_URL=

# --- Observability ---
OTEL_SERVICE_NAME=support-assistant
# e.g. http://localhost:4317 (OTLP/gRPC collector or Jaeger all-in-one)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE=false
